# ==============================================================================
# GROWIT – Plant Recommendation Website - Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# --- Flask Backend Settings ---
FLASK_ENV=development
FLASK_APP=backend.app:create_app
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
SECRET_KEY=replace-with-a-secure-random-secret-key
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- PostgreSQL Database Configuration ---
# Standard full database URL format: postgresql://<user>:<password>@<host>:<port>/<database_name>
# Example for default local PostgreSQL: postgresql://postgres:your_password@localhost:5432/plant_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plant_db

# Granular parameters (used if DATABASE_URL is not set or empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plant_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Streamlit Frontend Settings ---
BACKEND_API_URL=http://localhost:5000/api/v1
STREAMLIT_SERVER_PORT=8501

# --- External Plant API Keys ---
# Perenual API (https://perenual.com/docs/api) — register for a free key
PERENUAL_API_KEY=

# Trefle API (https://trefle.io/) — optional secondary provider
TREFLE_API_KEY=

# Generic provider-agnostic aliases used by PlantApiService
# PLANT_API_KEY takes precedence over PERENUAL_API_KEY when both are set
PLANT_API_KEY=
PLANT_API_BASE_URL=
PLANT_API_TIMEOUT=8
PLANT_API_CACHE_TTL=300
